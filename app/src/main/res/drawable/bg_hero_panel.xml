<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#24304A"
                android:endColor="#141A2B" />
            <corners android:radius="34dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#2C3650"
                android:endColor="#181E31" />
            <corners android:radius="33dp" />
        </shape>
    </item>

</layer-list>