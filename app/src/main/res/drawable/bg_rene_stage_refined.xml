<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#07100D" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#241F5D39"
                android:centerColor="#15112024"
                android:endColor="#20110B16"
                android:type="linear" />
            <corners android:radius="27dp" />
            <stroke
                android:width="1dp"
                android:color="#552EE06E" />
        </shape>
    </item>
</layer-list>
