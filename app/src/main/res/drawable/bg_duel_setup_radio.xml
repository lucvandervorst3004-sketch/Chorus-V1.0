<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <solid android:color="#22FF006E" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#88FF006E" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#66101A35" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#33425A86" />
        </shape>
    </item>
</selector>
