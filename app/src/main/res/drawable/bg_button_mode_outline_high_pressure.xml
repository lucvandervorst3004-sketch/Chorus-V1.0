<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#26090C" />
            <stroke
                android:width="1dp"
                android:color="#FF7B87" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#110406" />
            <stroke
                android:width="1dp"
                android:color="#8E1822" />
        </shape>
    </item>
</selector>