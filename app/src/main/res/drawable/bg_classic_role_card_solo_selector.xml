<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#1C1230"
                android:endColor="#111A35" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#D8F2C96A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#120B21"
                android:endColor="#0B122A" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#3E334F" />
        </shape>
    </item>
</selector>
