<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#223053" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#3D4E77" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#17233F" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#2D3C62" />
        </shape>
    </item>
</selector>
