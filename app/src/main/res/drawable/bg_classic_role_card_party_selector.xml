<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#082146"
                android:endColor="#0B1936" />
            <corners android:radius="24dp" />
            <stroke
                android:width="2dp"
                android:color="#CC00D9FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#071A39"
                android:endColor="#08142D" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#244F84" />
        </shape>
    </item>
</selector>
