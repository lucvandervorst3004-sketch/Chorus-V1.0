<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#30333C" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#33404B5C" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#F2C96A"
                android:endColor="#C9973A"
                android:type="linear" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="#FFFFF2C8" />
        </shape>
    </item>
</selector>
