<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#2A0A0E" />
            <stroke
                android:width="1dp"
                android:color="#FF6672" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#140608" />
            <stroke
                android:width="1dp"
                android:color="#9D1C28" />
        </shape>
    </item>
</selector>