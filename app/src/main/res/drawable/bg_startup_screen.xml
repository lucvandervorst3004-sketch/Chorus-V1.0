<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#060A14"
                android:centerColor="#09142A"
                android:endColor="#060A13" />
        </shape>
    </item>

    <item android:gravity="center">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="136dp" android:height="136dp" />
                    <gradient
                        android:type="radial"
                        android:gradientRadius="68dp"
                        android:startColor="#16C9973A"
                        android:endColor="#00C9973A" />
                </shape>
            </item>
            <item android:gravity="center">
                <shape android:shape="oval">
                    <size android:width="112dp" android:height="112dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#111A31"
                        android:endColor="#0A1122" />
                    <stroke android:width="1dp" android:color="#304267" />
                </shape>
            </item>
            <item android:gravity="center">
                <inset
                    android:insetLeft="34dp"
                    android:insetTop="34dp"
                    android:insetRight="34dp"
                    android:insetBottom="34dp"
                    android:drawable="@drawable/ic_chorus_logo" />
            </item>
        </layer-list>
    </item>
</layer-list>
