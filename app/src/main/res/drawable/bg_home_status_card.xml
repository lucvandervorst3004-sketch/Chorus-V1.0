<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#050A16" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#152242"
                android:endColor="#0C1731" />
            <corners android:radius="27dp" />
            <stroke
                android:width="1dp"
                android:color="#4B3F28" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <solid android:color="@color/home_panel" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#2B3B61" />
        </shape>
    </item>
</layer-list>
