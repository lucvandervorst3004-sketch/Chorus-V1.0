<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#040914" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/home_button_top"
                android:endColor="@color/home_button_bottom" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="@color/home_button_stroke" />
        </shape>
    </item>
    <item android:left="10dp" android:top="3dp" android:right="10dp" android:bottom="30dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
