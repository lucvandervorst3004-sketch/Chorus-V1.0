<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#090204" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <gradient
                android:angle="315"
                android:startColor="#2B1408"
                android:centerColor="#160608"
                android:endColor="#0A0204"
                android:type="linear" />
            <corners android:radius="29dp" />
            <stroke
                android:width="2dp"
                android:color="#B8FF006E" />
        </shape>
    </item>
</layer-list>
