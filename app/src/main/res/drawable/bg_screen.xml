<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/dark_base"
                android:centerColor="#101428"
                android:endColor="#07101F" />
        </shape>
    </item>

    <item android:top="-160dp" android:right="-140dp">
        <shape android:shape="oval">
            <size
                android:width="420dp"
                android:height="420dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="210dp"
                android:startColor="#1F00D9FF"
                android:endColor="#0000D9FF" />
        </shape>
    </item>

    <item android:bottom="-190dp" android:left="-160dp">
        <shape android:shape="oval">
            <size
                android:width="470dp"
                android:height="470dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="235dp"
                android:startColor="#22F2C96A"
                android:endColor="#00F2C96A" />
        </shape>
    </item>
</layer-list>
