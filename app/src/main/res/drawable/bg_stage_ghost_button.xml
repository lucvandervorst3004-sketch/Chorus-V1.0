<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1B2644" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#354A75" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#101A31" />
            <corners android:radius="23dp" />
            <stroke android:width="1dp" android:color="#27385F" />
        </shape>
    </item>
</selector>
