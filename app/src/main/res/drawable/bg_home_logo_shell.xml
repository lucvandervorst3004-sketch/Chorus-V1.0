<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#111B34"
                android:endColor="#0A1226" />
            <stroke
                android:width="1dp"
                android:color="#31456D" />
        </shape>
    </item>
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#0B1020" />
            <stroke
                android:width="1dp"
                android:color="#36C9973A" />
        </shape>
    </item>
</layer-list>
