<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stage_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/contentSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCloseSettings"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_mode_outline"
                android:backgroundTint="@null"
                android:fontFamily="@font/manrope_bold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="← Terug"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_home_play_pill"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:letterSpacing="0.14"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Settings"
                android:textAllCaps="true"
                android:textColor="@color/gold_bright"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsHeroCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_hero_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/bg_settings_logo_shell"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_chorus_logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:text="Control center"
                    android:textColor="@color/home_text_primary"
                    android:textSize="31sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Beheer verbinding, sessiegedrag en scores zonder je gameflow te verliezen."
                    android:textColor="@color/home_text_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSpotifyConnection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_connection_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/settingsConnectionIconShell"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_settings_connection_icon"
                    android:padding="11dp">

                    <ImageView
                        android:id="@+id/imageSettingsConnectionIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Spotify"
                        android:src="@drawable/ic_settings_link"
                        android:tint="@color/gold_bright" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_scanner_badge"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:letterSpacing="0.12"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="SPOTIFY"
                        android:textAllCaps="true"
                        android:textColor="@color/gold_bright"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/textConnectionValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Niet gekoppeld"
                        android:textColor="@color/gold_bright"
                        android:textSize="23sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/buttonReconnect"
                    android:layout_width="104dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_party_primary_button"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/manrope_bold"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Koppel"
                    android:textAllCaps="false"
                    android:textColor="@color/text_dark"
                    android:textSize="14sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/textConnectionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/manrope_regular"
                android:lineSpacingExtra="2dp"
                android:text="Koppel Spotify vanaf het startscherm om direct te kunnen spelen."
                android:textColor="@color/home_text_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardSessionPreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_scanner_state_icon"
                android:padding="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Scherm"
                    android:src="@drawable/ic_settings_screen"
                    android:tint="@color/gold_bright" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Scherm actief houden"
                    android:textColor="@color/home_text_primary"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Voorkomt dimmen tijdens luisteren, scannen en score controleren."
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchKeepScreenOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                app:switchMinWidth="56dp"
                app:thumbTint="@color/gold_bright"
                app:trackTint="@color/card_stroke" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPracticeStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Practice scores"
                    android:textColor="@color/home_text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_classic_choice_chip"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="All-time"
                    android:textColor="@color/home_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_score_dutch"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/textPracticeHighscoreDutchValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bowlby_one_sc_regular"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/neon_green"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:text="Nederlandstalig"
                        android:textColor="@color/home_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_settings_score_world"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/textPracticeHighscoreEnglishValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bowlby_one_sc_regular"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/gold_bright"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:text="Wereldwijd"
                        android:textColor="@color/home_text_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/buttonResetPracticeHighscoreDutch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_secondary_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/manrope_bold"
                android:text="Reset Nederlandse highscore"
                android:textAllCaps="false"
                android:textColor="@color/button_secondary_text"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/buttonResetPracticeHighscoreEnglish"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_settings_secondary_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/manrope_bold"
                android:text="Reset wereldwijde highscore"
                android:textAllCaps="false"
                android:textColor="@color/button_secondary_text"
                android:textSize="14sp"
                app:backgroundTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="App-info"
                android:textColor="@color/home_text_primary"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_settings_info_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Spelmodus"
                    android:textColor="@color/home_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textModeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Classic Mode"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_info_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Camera"
                    android:textColor="@color/home_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textCameraPermissionValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Toegestaan"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_info_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Appversie"
                    android:textColor="@color/home_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textVersionValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Versie 1.0"
                    android:textColor="@color/home_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_settings_info_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/manrope_regular"
                    android:text="Maker"
                    android:textColor="@color/home_text_muted"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Gemaakt door Luc van der Vorst"
                    android:textColor="@color/gold_bright"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.12"
                android:text="LAATSTE MELDING"
                android:textColor="@color/gold_bright"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/textErrorValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_settings_info_row"
                android:fontFamily="@font/manrope_regular"
                android:lineSpacingExtra="2dp"
                android:padding="14dp"
                android:text="Geen meldingen"
                android:textColor="@color/home_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
