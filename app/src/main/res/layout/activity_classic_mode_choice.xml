<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootClassicModeChoice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_classic_choice_screen"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/contentClassicModeChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonBackClassicMode"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_classic_back_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/manrope_bold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="← Terug"
                android:textAllCaps="false"
                android:textColor="#C9D3EB"
                android:textSize="13sp"
                app:backgroundTint="@null" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_home_play_pill"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:letterSpacing="0.16"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Classic"
                android:textAllCaps="true"
                android:textColor="@color/gold_bright"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_hero_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:includeFontPadding="false"
                    android:text="Classic setup"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Kies eerst Party of Solo. Daarna start je Casual of High Pressure."
                    android:textColor="@color/home_text_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_classic_option_icon_gold"
                android:padding="13dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Classic"
                    android:src="@drawable/ic_mode_classic"
                    android:tint="@color/gold_bright" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/manrope_bold"
            android:letterSpacing="0.18"
            android:text="STAP 1 · PARTY OF SOLO"
            android:textColor="@color/home_text_section"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/buttonPartyClassic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_classic_role_card_party_selector"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_classic_option_icon_cyan"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Party"
                    android:src="@drawable/ic_classic_party"
                    android:tint="@color/neon_cyan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Party"
                    android:textColor="@color/neon_cyan"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="De groep raadt samen, zonder antwoordscherm tijdens het spel."
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textPartySelectionChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_classic_selected_chip"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Gekozen"
                android:textColor="@color/text_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonSoloClassic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_classic_role_card_solo_selector"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_classic_option_icon_gold"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Solo"
                    android:src="@drawable/ic_classic_solo"
                    android:tint="@color/gold_bright" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Solo"
                    android:textColor="@color/gold_bright"
                    android:textSize="25sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Jij speelt alleen en krijgt het antwoordscherm in de app."
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textSoloSelectionChip"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_classic_choice_chip"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:minWidth="76dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Kies"
                android:textColor="#D8E3FF"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.18"
                android:text="STAP 2 · INTENSITEIT"
                android:textColor="@color/home_text_section"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textClassicSelectedRole"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_classic_choice_chip"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Party gekozen"
                android:textColor="#D8E3FF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonCasualClassic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_classic_variant_casual_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="98dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_classic_option_icon_gold"
                android:padding="12dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Casual"
                    android:src="@drawable/ic_classic_lp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="Casual"
                    android:textColor="@color/gold_bright"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Normale Classic ronde met rustige timing."
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_classic_variant_button_outline"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="Start"
                android:textColor="#D8E3FF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonHighPressureClassic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_classic_variant_pressure_card"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="104dp"
            android:orientation="horizontal"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_classic_option_icon_red"
                android:padding="11dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="High Pressure"
                    android:src="@drawable/ic_classic_flame"
                    android:tint="@color/neon_red" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="High Pressure"
                    android:textColor="#FFF2F3"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="Tien seconden. Geen pauze. Meteen antwoord geven."
                    android:textColor="#D2AAB0"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="72dp"
                android:layout_height="42dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_classic_variant_button_high_pressure"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:text="Start"
                android:textColor="#FFF7F8"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
