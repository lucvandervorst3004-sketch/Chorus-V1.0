<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_stage_screen"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonCloseScanner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_mode_outline"
            android:backgroundTint="@null"
            android:fontFamily="@font/manrope_bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="← Terug"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:backgroundTint="@null" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/buttonOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_mode_outline"
            android:backgroundTint="@null"
            android:fontFamily="@font/manrope_bold"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Instellingen"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/scannerHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_scanner_header_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_classic_option_icon_gold"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imageScannerModeIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Scanner mode"
                android:src="@drawable/ic_classic_lp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textScannerEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_scanner_badge"
                android:fontFamily="@font/manrope_bold"
                android:gravity="center"
                android:letterSpacing="0.14"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="SCANNER"
                android:textAllCaps="true"
                android:textColor="@color/gold_bright"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/textScannerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/manrope_bold"
                android:includeFontPadding="false"
                android:text="Scan je kaart"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/textScanInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/manrope_regular"
                android:lineSpacingExtra="2dp"
                android:text="Houd de QR-code binnen het kader."
                android:textColor="@color/home_text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textScannerRoleChip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_scanner_chip_party"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Party Mode"
            android:textColor="@color/neon_cyan"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/textScannerVariantChip"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_scanner_chip_casual"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:text="Casual"
            android:textColor="@color/gold_bright"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/scanTargetContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_scanner_camera_frame"
        android:minHeight="280dp"
        android:padding="13dp">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#050913" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_scanner_camera_overlay" />

        <View
            android:id="@+id/viewScanLine"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_scan_line"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textScannerLiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_scanner_live_badge"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="LIVE"
            android:textAllCaps="true"
            android:textColor="@color/gold_bright"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/imageScannerCornerTopStart"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="12dp"
            android:layout_marginTop="54dp"
            android:src="@drawable/bg_scan_corner_tl"
            android:tint="@color/gold_bright" />

        <ImageView
            android:id="@+id/imageScannerCornerTopEnd"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/bg_scan_corner_tr"
            android:tint="@color/gold_bright" />

        <ImageView
            android:id="@+id/imageScannerCornerBottomStart"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/bg_scan_corner_bl"
            android:tint="@color/gold_bright" />

        <ImageView
            android:id="@+id/imageScannerCornerBottomEnd"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/bg_scan_corner_br"
            android:tint="@color/gold_bright" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_scanner_qr_hint"
            android:fontFamily="@font/manrope_bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="QR binnen het kader"
            android:textColor="@color/home_text_muted"
            android:textSize="10sp" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/scannerInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_scanner_status_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <FrameLayout
            android:id="@+id/scannerStateIconShell"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_scanner_state_icon"
            android:padding="10dp">

            <ImageView
                android:id="@+id/imageScannerStateIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Scanner status"
                android:src="@drawable/ic_scanner_qr"
                android:tint="@color/gold_bright" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textScannerStateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/manrope_bold"
                android:text="Scanner klaar"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textScannerStateBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/manrope_regular"
                android:lineSpacingExtra="2dp"
                android:text="Nummer start automatisch zodra de kaart herkend is."
                android:textColor="@color/home_text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
