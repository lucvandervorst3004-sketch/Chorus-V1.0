<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootDuelSetup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duel_screen">

    <ScrollView
        android:id="@+id/scrollDuelSetup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/contentDuelSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/buttonBackDuelSetup"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_button_mode_outline"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/manrope_bold"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/duel_back"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:backgroundTint="@null" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_duel_setup_top_badge"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:letterSpacing="0.14"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/duel_setup_badge"
                    android:textAllCaps="true"
                    android:textColor="@color/neon_red"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_duel_setup_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_duel_setup_micro_badge"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:letterSpacing="0.14"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="1 VS 1"
                        android:textAllCaps="true"
                        android:textColor="@color/home_text_section"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_bold"
                        android:includeFontPadding="false"
                        android:text="@string/duel_setup_title"
                        android:textColor="@color/home_text_primary"
                        android:textSize="34sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/manrope_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/duel_setup_subtitle"
                        android:textColor="@color/home_text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bg_duel_setup_icon_shell"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/duel_setup_title"
                        android:src="@drawable/ic_mode_duel"
                        android:tint="@color/neon_red" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/manrope_bold"
                android:letterSpacing="0.18"
                android:text="SPELERS"
                android:textColor="@color/home_text_section"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_duel_setup_player_red"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_duel_setup_avatar_red"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/duel_player_one_hint"
                            android:src="@drawable/ic_duel_buzzer_glyph"
                            android:tint="@color/neon_red" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Speler 1"
                        android:textColor="@color/neon_red"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/duel_player_one_hint"
                        app:boxBackgroundColor="#221018"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/neon_red"
                        app:hintTextColor="#FFD2D2">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPlayerOneName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_bold"
                            android:padding="12dp"
                            android:singleLine="true"
                            android:textColor="@color/home_text_primary"
                            android:textColorHint="#CFCFCF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_duel_setup_player_blue"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_duel_setup_avatar_blue"
                        android:padding="11dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/duel_player_two_hint"
                            android:src="@drawable/ic_duel_buzzer_glyph"
                            android:tint="@color/neon_cyan" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/manrope_bold"
                        android:text="Speler 2"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="@string/duel_player_two_hint"
                        app:boxBackgroundColor="#0C1826"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxStrokeColor="@color/neon_cyan"
                        app:hintTextColor="#D6E5FF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPlayerTwoName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/manrope_bold"
                            android:padding="12dp"
                            android:singleLine="true"
                            android:textColor="@color/home_text_primary"
                            android:textColorHint="#CFCFCF"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_duel_setup_rules_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.14"
                    android:text="REGELS"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_bright"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope_regular"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/duel_setup_instructions"
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_duel_setup_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:text="@string/duel_category_title"
                    android:textColor="@color/home_text_primary"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/radioGroupCategories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioCategoryEnglish"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_duel_setup_radio"
                        android:buttonTint="@color/neon_red"
                        android:fontFamily="@font/manrope_bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/duel_category_english"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioCategoryDutch"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_duel_setup_radio"
                        android:buttonTint="@color/neon_red"
                        android:fontFamily="@font/manrope_bold"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/duel_category_dutch"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_duel_setup_score_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/duel_first_to_title"
                        android:textColor="@color/home_text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textWinningScoreValue"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_duel_score_pill_gold"
                        android:fontFamily="@font/manrope_bold"
                        android:gravity="center"
                        android:minWidth="126dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/gold_bright"
                        android:textSize="14sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekWinningScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="15"
                    android:progress="7"
                    android:progressTint="@color/neon_red"
                    android:progressBackgroundTint="#33425A86"
                    android:thumbTint="@color/gold_bright" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope_regular"
                    android:text="@string/duel_first_to_helper"
                    android:textColor="@color/home_text_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonStartDuel"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_duel_setup_start_button"
                android:backgroundTint="@null"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/duel_button_start"
                android:textAllCaps="false"
                android:textColor="@color/home_text_primary"
                android:textSize="18sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
