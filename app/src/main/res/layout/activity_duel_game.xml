<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duel_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="52dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:weightSum="8">

        <LinearLayout
            android:id="@+id/layoutPlayerTwoSide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical"
            android:rotation="180">

            <LinearLayout
                android:id="@+id/buttonBuzzTop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_duel_table_buzzer_top"
                android:clickable="true"
                android:contentDescription="@string/duel_buzz"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textPlayerTwoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:letterSpacing="0.16"
                    android:maxLines="1"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textAllCaps="true" />

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/duel_buzz"
                    android:src="@drawable/ic_duel_buzzer_glyph"
                    android:tint="@color/neon_cyan" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/bowlby_one_sc_regular"
                    android:text="@string/duel_buzz"
                    android:textColor="@color/home_text_primary"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/textPlayerTwoScore"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_duel_score_pill_cyan"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:minWidth="80dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/home_text_primary"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/scrollCenterArena"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="2"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCenterArena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duel_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/textRoundCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/manrope_bold"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:textColor="@color/home_text_section"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textCategoryLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/manrope_bold"
                    android:textColor="@color/neon_cyan"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/textArenaStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/bowlby_one_sc_regular"
                    android:gravity="center"
                    android:textColor="@color/home_text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textArenaHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/home_text_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/cardBuzzedPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_duel_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textBuzzedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bowlby_one_sc_regular"
                        android:textColor="@color/home_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/textBuzzedBody"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/home_text_muted"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/buttonRevealAnswer"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_duel_button_primary"
                        android:backgroundTint="@null"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/duel_button_reveal_answer"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardRevealPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_duel_card"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/textRevealTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/bowlby_one_sc_regular"
                        android:textColor="@color/home_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/textRevealAnswer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/home_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/textRevealResult"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/home_text_muted"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/layoutJudgementButtons"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/buttonMarkWrong"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_duel_button_wrong"
                            android:contentDescription="@string/duel_mark_wrong_content_description"
                            android:padding="22dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:tint="@android:color/white" />

                        <Space
                            android:layout_width="16dp"
                            android:layout_height="1dp" />

                        <ImageButton
                            android:id="@+id/buttonMarkCorrect"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:background="@drawable/bg_duel_button_correct"
                            android:contentDescription="@string/duel_mark_correct_content_description"
                            android:padding="22dp"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/checkbox_on_background"
                            android:tint="@android:color/white" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonNextRound"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_duel_button_primary"
                        android:backgroundTint="@null"
                        android:fontFamily="@font/manrope_bold"
                        android:text="@string/duel_next_round"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:backgroundTint="@null" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/layoutPlayerOneSide"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/buttonBuzzBottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_duel_table_buzzer_bottom"
                android:clickable="true"
                android:contentDescription="@string/duel_buzz"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textPlayerOneName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:letterSpacing="0.16"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textColor="@color/gold_bright"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/duel_buzz"
                    android:src="@drawable/ic_duel_buzzer_glyph"
                    android:tint="@color/gold_bright" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/bowlby_one_sc_regular"
                    android:text="@string/duel_buzz"
                    android:textColor="@color/home_text_primary"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/textPlayerOneScore"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_duel_score_pill_gold"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:minWidth="80dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/home_text_primary"
                    android:textSize="22sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/layoutBuzzButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonExitDuel"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:background="@drawable/bg_duel_button_secondary"
        android:backgroundTint="@null"
        android:fontFamily="@font/manrope_bold"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/duel_exit"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        app:backgroundTint="@null" />

</FrameLayout>
