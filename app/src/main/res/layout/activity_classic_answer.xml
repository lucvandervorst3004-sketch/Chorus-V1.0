<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/answerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textAnswerEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_eyebrow"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="• SOLO MODE"
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAnswerLineOne"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Jouw"
            android:textColor="@color/text_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAnswerLineTwo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="antwoord"
            android:textColor="@color/accent_amber"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAnswerHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vul je gok in en toon daarna het echte antwoord wanneer je klaar bent."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/textAnswerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Vul hieronder je jaartal, nummer en artiest in."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/layoutGuessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_hero_panel"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textGuessLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JOUW GOK"
                android:textColor="@color/accent_amber"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputYear"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_answer_input"
                android:backgroundTint="@null"
                android:gravity="center_vertical"
                android:hint="Jaartal"
                android:inputType="number"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:backgroundTint="@null" />

            <EditText
                android:id="@+id/inputTitle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_answer_input"
                android:backgroundTint="@null"
                android:gravity="center_vertical"
                android:hint="Nummer"
                android:inputType="textCapWords|textNoSuggestions"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:backgroundTint="@null" />

            <EditText
                android:id="@+id/inputArtist"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_answer_input"
                android:backgroundTint="@null"
                android:gravity="center_vertical"
                android:hint="Artiest"
                android:inputType="textCapWords|textNoSuggestions"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                app:backgroundTint="@null" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonRevealAnswer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:backgroundTint="@null"
            android:text="Toon antwoord"
            android:textAllCaps="false"
            android:textColor="@color/button_primary_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <LinearLayout
            android:id="@+id/layoutRevealCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textRevealTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Echt antwoord"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRevealSong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nummer:"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textRevealArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Artiest:"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textRevealYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Jaartal:"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonBackToPlayer"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:text="Terug naar speler"
            android:textAllCaps="false"
            android:textColor="@color/button_secondary_text"
            android:textSize="17sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="120dp" />

    </LinearLayout>
</ScrollView>