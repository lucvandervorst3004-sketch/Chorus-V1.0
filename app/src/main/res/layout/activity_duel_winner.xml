<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootDuelWinner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_duel_screen">

    <LinearLayout
        android:id="@+id/contentDuelWinner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_duel_winner_shell"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_duel_card"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_home_icon_shell"
                    android:contentDescription="@string/duel_score_overview_title"
                    android:padding="12dp"
                    android:src="@drawable/ic_duel_trophy" />

                <TextView
                    android:id="@+id/textWinnerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/textWinnerSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="#8E96AF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textWinnerPlayerOne"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_duel_score_pill_red"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#FFB5B5"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textWinnerPlayerTwo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_duel_score_pill_blue"
                    android:fontFamily="@font/manrope_bold"
                    android:gravity="center"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:textColor="#BFD7FF"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/buttonNewDuelGame"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_duel_button_primary"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/duel_new_game"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@null" />

            <Button
                android:id="@+id/buttonWinnerHome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_duel_button_secondary"
                android:fontFamily="@font/manrope_bold"
                android:text="@string/duel_back_home"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:backgroundTint="@null" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
